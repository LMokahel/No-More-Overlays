{
  "schemaVersion": 1,
  "id": "nomoreoverlays",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Minecraft mod that allows the user to toggle all of Minecraft's screen effects.",
  "authors": [
    "DontNag"
  ],
  "contact": {
    "issues": "https://github.com/LMokahel/No-More-Overlays/issues",
    "sources": "https://github.com/LMokahel/No-More-Overlays"
  },
  "license": "CC0-1.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "modmenu": [
      "com.dontnag.fabric.ModMenuCompat"
    ],
    "client": [
      "com.dontnag.fabric.NoMoreOverlaysFabric"
    ]
  },
  "mixins": [
    "nomoreoverlays.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.12.0",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "cloth-config": "*",
    "modmenu": ">=${mod_menu_version}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
